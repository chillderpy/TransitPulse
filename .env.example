# LTA DataMall account key. Register at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=your-account-key-here

# Port the API server listens on
PORT=3000

# CORS origin allowed to call this API (the Flutter app's dev origin, or * while prototyping)
CORS_ORIGIN=*

# Base URL for LTA DataMall's OData service. Override only if LTA changes it.
LTA_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice

# Set to "true" to let POST /api/reroute accept a `mockDisruption` scenario
# name (see src/services/mockDisruptions.ts) instead of live LTA data - handy
# for demoing the reroute engine's disruption handling on demand. Off by
# default.
ENABLE_MOCK_DISRUPTIONS=false
